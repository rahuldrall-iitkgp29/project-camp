{
  "name": "project-mangement",
  "version": "1.0.0",
  "description": "a jira like mangement system on node",
  "keywords": [
    "backend",
    "api",
    "creation"
  ],
  "license": "ISC",
  "author": "Rahul Drall",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon ./src/index.js",
    "dev:local": "node scripts/dev-local.js",
    "start": "node src/index.js",
    "test": "node --test tests/auth.test.js tests/contracts.test.js tests/project.test.js tests/mongodb-safety.test.js",
    "test:unit": "npm test",
    "test:integration": "node --test tests/integration.test.js",
    "mongodb:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mongodb.ps1 Install",
    "mongodb:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mongodb.ps1 Start",
    "mongodb:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mongodb.ps1 Status",
    "mongodb:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mongodb.ps1 Stop",
    "mongodb:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mongodb.ps1 Smoke",
    "format": "prettier --write .",
    "dev:verify": "node scripts/verify-user.js",
    "seed:demo": "node scripts/seed-demo.js"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prettier": "3.9.4"
  },
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailgen": "^2.0.7",
    "@types/nodemailer": "^8.0.2",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mailgen": "^2.0.36",
    "mongoose": "^9.7.3",
    "mongosh": "^2.14.0",
    "multer": "^2.3.0",
    "nodemailer": "^9.1.1"
  }
}
